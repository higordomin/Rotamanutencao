name: Compilar APK - RotaManutencao

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - RotaManutencao_Projeto_Android.zip
      - .github/workflows/compilar-apk.yml

permissions:
  contents: read

jobs:
  android:
    name: Compilar Android offline
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - name: Obter arquivos do repositório
        uses: actions/checkout@v4

      - name: Extrair projeto Android
        run: |
          mkdir -p projeto
          unzip -q RotaManutencao_Projeto_Android.zip -d projeto
          test -f projeto/app/build.gradle
          test -f projeto/app/src/main/AndroidManifest.xml

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar plataforma Android 35
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'

      - name: Configurar Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Gerar APK de teste
        working-directory: projeto
        run: gradle --no-daemon --stacktrace assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: RotaManutencao-APK
          path: projeto/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
