{
  "expo": {
    "name": "RotaManutenção",
    "slug": "rotamanutencao",
    "version": "0.7.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "br.com.rotamanutencao.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08101E"
      },
      "versionCode": 71
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos para anexar aos registros de manutenção.",
          "cameraPermission": "Fotografar evidências dos serviços de manutenção.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
